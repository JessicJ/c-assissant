{
  "name": "@c-assistant/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/telegram-commands.test.ts src/arrival-reminder.test.ts src/arrival-route.test.ts src/telegram-plan.test.ts src/official-sources.test.ts src/task-reminder.test.ts",
    "start": "node lib/index.js"
  },
  "dependencies": {
    "@c-assistant/agent-adapters": "workspace:*",
    "@c-assistant/connectors": "workspace:*",
    "@c-assistant/core": "workspace:*",
    "@c-assistant/storage": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2"
  }
}
