# Runtime selection: codex or claude-code
C_ASSISTANT_RUNTIME=codex

# User-owned instance secrets. Never commit populated values.
TELEGRAM_BOT_TOKEN=
GOOGLE_MAPS_API_KEY=

# Optional WhatsApp Business Platform Connector.
# Keep all real values only in the ignored local .env.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ALLOWED_USER_NUMBER=
WHATSAPP_REMINDER_TEMPLATE_NAME=
WHATSAPP_GRAPH_API_VERSION=

# Optional public Uber application client ID for ride-link attribution.
# Never put a client secret, access token, or server token here.
UBER_CLIENT_ID=

# Local Web/Core defaults
C_ASSISTANT_HOST=127.0.0.1
C_ASSISTANT_PORT=8787

# Optional. Defaults to data/c-assistant.sqlite in the project directory.
C_ASSISTANT_DATA_PATH=
LANDI_BLUEPRINT_GENERATION=1
