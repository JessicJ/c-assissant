# Runtime selection: codex or claude-code
C_ASSISTANT_RUNTIME=codex

# User-owned instance secrets. Never commit populated values.
GOOGLE_MAPS_API_KEY=

# Travel email sender: configured once by the instance owner in Settings.
# Use an application-specific SMTP credential; never commit populated values.
# Port 587 requires STARTTLS; port 465 uses TLS from connection start.
LANDI_SMTP_HOST=
LANDI_SMTP_PORT=587
LANDI_SMTP_USER=
LANDI_SMTP_PASSWORD=
LANDI_EMAIL_FROM=

# Optional SMTP-only direct route. Leave both blank to use system networking.
# Choose your physical interface and either IPv4 DNS servers or HTTPS DNS below.
# Missing interface/DNS fails without falling back to the proxy route.
LANDI_SMTP_DIRECT_INTERFACE=
LANDI_SMTP_DIRECT_DNS=
# Alternative DNS resolution through fixed Google HTTPS DNS, using only a
# credential-free loopback HTTP proxy. SMTP itself still uses the direct interface.
# When configured, the UDP DNS list above is unused.
LANDI_SMTP_DNS_HTTPS_PROXY=

# Itinerary changes are reviewed and confirmed in the Landi workspace.

# Optional public Uber application client ID for ride-link attribution.
# Never put a client secret, access token, or server token here.
UBER_CLIENT_ID=

# Local Web/Core defaults
C_ASSISTANT_HOST=127.0.0.1
C_ASSISTANT_PORT=8787

# Optional. Defaults to data/c-assistant.sqlite in the project directory.
C_ASSISTANT_DATA_PATH=
LANDI_BLUEPRINT_GENERATION=1

# Optional static illustration override. Blank uses Landi's shared, version-pinned public artwork.
# Example layout: <base>/important-update/v1/attraction-closure.jpg
# No image API, upload credential or per-computer setup is required for the default.
LANDI_EMAIL_ASSET_BASE_URL=
