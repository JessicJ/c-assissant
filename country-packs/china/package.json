{
  "name": "@c-assistant/china-country-pack",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "China Country Pack for Landi",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./registry": {
      "types": "./lib/registry.d.ts",
      "default": "./lib/registry.js"
    },
    "./orchestrator": {
      "types": "./lib/orchestrator.d.ts",
      "default": "./lib/orchestrator.js"
    },
    "./reference-catalog": {
      "types": "./lib/reference-catalog.d.ts",
      "default": "./lib/reference-catalog.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/index.test.ts src/orchestrator.test.ts src/reference-catalog.test.ts"
  },
  "dependencies": {
    "@c-assistant/core": "workspace:*",
    "@c-assistant/skill-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2"
  }
}
