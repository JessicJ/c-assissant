        {"if":{"properties":{"sourceKind":{"const":"weather_current"}}},"then":{"properties":{"candidate":{"type":"object","additionalProperties":false,"required":["kind","locationName","condition","observedAt"],"properties":{"kind":{"const":"weather_current"},"locationName":{"type":"string","minLength":1,"maxLength":240},"latitude":{"type":"number","minimum":-90,"maximum":90},"longitude":{"type":"number","minimum":-180,"maximum":180},"condition":{"type":"string","minLength":1,"maxLength":240},"conditionCode":{"type":"string","minLength":1,"maxLength":80},"observedAt":{"oneOf":[{"$ref":"#/$defs/instant"},{"type":"null"}]},"temperatureC":{"type":"number"},"feelsLikeC":{"type":"number"},"humidityPercent":{"type":"number","minimum":0,"maximum":100},"windDirection":{"type":"string","minLength":1,"maxLength":80},"windScale":{"type":"string","minLength":1,"maxLength":80},"precipitationMm":{"type":"number","minimum":0}}}}}},
        {"if":{"properties":{"sourceKind":{"const":"weather_forecast"}}},"then":{"properties":{"candidate":{"type":"object","additionalProperties":false,"required":["kind","locationName","date","conditionDay","conditionNight"],"properties":{"kind":{"const":"weather_forecast"},"locationName":{"type":"string","minLength":1,"maxLength":240},"latitude":{"type":"number","minimum":-90,"maximum":90},"longitude":{"type":"number","minimum":-180,"maximum":180},"date":{"type":"string","format":"date"},"conditionDay":{"type":"string","minLength":1,"maxLength":240},"conditionNight":{"type":"string","minLength":1,"maxLength":240},"highC":{"type":"number"},"lowC":{"type":"number"},"precipitationMm":{"type":"number","minimum":0},"uvIndex":{"type":"number","minimum":0}}}}}},
        {"if":{"properties":{"sourceKind":{"const":"saved_booking"}}},"then":{"properties":{"candidate":{"type":"object","additionalProperties":false,"required":["kind","bookingId","segmentId","status","segmentStatus","bookingConstraintStrength","segmentConstraintStrength","fixedCommitment"],"properties":{"kind":{"const":"saved_booking"},"bookingId":{"type":"string","minLength":1,"maxLength":160},"segmentId":{"type":"string","minLength":1,"maxLength":160},"status":{"type":"string","minLength":1,"maxLength":80},"segmentStatus":{"type":"string","minLength":1,"maxLength":80},"startAtLocal":{"type":"string","minLength":1,"maxLength":80},"startTimeZone":{"type":"string","minLength":1,"maxLength":80},"endAtLocal":{"type":"string","minLength":1,"maxLength":80},"endTimeZone":{"type":"string","minLength":1,"maxLength":80},"bookingConstraintStrength":{"enum":["hard","soft","ignored"]},"segmentConstraintStrength":{"enum":["hard","soft","ignored"]},"fixedCommitment":{"type":"boolean"}}}}}},
        {"if": {"properties": {"sourceKind": {"const": "saved_booking"}}}, "then": {"required": ["sourceRevision"]}},
        {"if": {"properties": {"status": {"enum": ["changed", "unchanged"]}}}, "then": {"properties": {"targetDate": {"type": "string"}, "timeZone": {"type": "string"}, "factObservedAt": {"type": "string"}, "validUntil": {"type": "string"}, "evidenceRefs": {"minItems": 1}}}}
