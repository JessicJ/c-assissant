        "modelId": {"type": ["string", "null"], "minLength": 1},
        "executionRef": {"type": ["string", "null"], "minLength": 1},
        "rationale": {"$ref": "#/$defs/text"},
        "obligations": {"$ref": "#/$defs/texts"},
        "evidenceRefs": {"$ref": "#/$defs/texts"}
      },
      "allOf": [{"if": {"properties": {"verdict": {"const": "eligible"}}}, "then": {"properties": {"agentId": {"type": "string"}, "modelId": {"type": "string"}, "executionRef": {"type": "string"}, "evidenceRefs": {"minItems": 1}}}}]
    },
