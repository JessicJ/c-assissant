{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "landi.travel-adjustment.v1",
  "description": "Landi 本地设计交换合同，由 email-execution.md 拥有；根格式不是实际持久 API。$defs/emailConsumption 是待实现的 Storage 只读邮件消费投影，须单独显式校验；结构通过不证明跨记录关联、来源可靠、执行核验、事务或运行就绪。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "episode", "idempotencyKey", "base", "context", "phase", "observations", "decision", "result"],
  "properties": {
    "schemaVersion": {"const": 1},
    "eventId": {"$ref": "#/$defs/text"},
    "episode": {"type": "integer", "minimum": 1},
    "idempotencyKey": {"$ref": "#/$defs/text"},
    "base": {"$ref": "#/$defs/versions"},
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["draft", "draftBlueprint", "sourceSetDigest", "observationSetDigest", "recipientRevision", "authorizationDigest"],
      "properties": {
        "draft": {"oneOf": [{"$ref": "#/$defs/version"}, {"type": "null"}]},
        "sourceSetDigest": {"$ref": "#/$defs/digest"},
        "recipientRevision": {"type": "integer", "minimum": 0},
        "authorizationDigest": {"$ref": "#/$defs/digest"},
        "observationSetDigest": {"$ref": "#/$defs/digest"},
        "draftBlueprint": {"oneOf": [{"$ref": "#/$defs/version"}, {"type": "null"}]}
      }
    },
    "phase": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "revision", "basis", "recordedAt", "evidenceRefs"],
      "properties": {
        "value": {"enum": ["pre_departure", "on_trip", "ended", "unknown"]},
        "revision": {"type": "integer", "minimum": 0},
        "basis": {"enum": ["traveler_statement", "verified_actual_fact", "unresolved"]},
        "recordedAt": {"$ref": "#/$defs/instant"},
        "evidenceRefs": {"$ref": "#/$defs/texts"}
      },
      "allOf": [{
        "if": {"properties": {"value": {"const": "unknown"}}},
        "then": {"properties": {"basis": {"const": "unresolved"}}},
        "else": {"properties": {"basis": {"enum": ["traveler_statement", "verified_actual_fact"]}, "evidenceRefs": {"minItems": 1}}}
      }]
    },
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
    "decision": {"$ref": "#/$defs/decision"},
    "result": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "reason", "unresolved", "evidenceRefs"],
          "properties": {
            "status": {"enum": ["unchanged", "pending_confirmation", "unresolved", "rejected"]},
            "reason": {"$ref": "#/$defs/text"},
            "unresolved": {"$ref": "#/$defs/texts"},
            "evidenceRefs": {"$ref": "#/$defs/texts"}
          }
        },
        {"$ref": "#/$defs/applied"}
      ]
    }
  },
  "allOf": [{
    "if": {"properties": {"result": {"properties": {"status": {"const": "applied"}}, "required": ["status"]}}},
    "then": {
      "properties": {"decision": {"properties": {"verdict": {"const": "eligible"}}}},
      "oneOf": [
        {"properties": {"phase": {"properties": {"value": {"const": "pre_departure"}}}, "result": {"properties": {"basis": {"const": "user_confirmation"}}, "required": ["confirmationRef"]}}},
        {"properties": {"observations": {"contains": {"properties": {"status": {"const": "changed"}}, "required": ["status"]}}, "phase": {"properties": {"value": {"const": "on_trip"}}}, "decision": {"properties": {"changeKind": {"const": "objective_disruption"}}}, "result": {"properties": {"basis": {"const": "objective_change"}}}}}
      ]
    }
  }],
