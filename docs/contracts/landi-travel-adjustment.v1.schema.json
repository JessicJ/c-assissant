        "provider": {"$ref": "#/$defs/text"},
        "targetDate": {"type": ["string", "null"], "format": "date"},
        "timeZone": {"type": ["string", "null"], "minLength": 1},
        "factObservedAt": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]},
        "retrievedAt": {"$ref": "#/$defs/instant"},
        "validUntil": {"oneOf": [{"$ref": "#/$defs/instant"}, {"type": "null"}]},
        "sourceRevision": {"$ref": "#/$defs/text"},
