      "type": "object", "additionalProperties": false, "required": ["plan", "blueprint"],
      "properties": {"plan": {"$ref": "#/$defs/version"}, "blueprint": {"$ref": "#/$defs/version"}}
    },
    "candidate": {"oneOf":[{"type":"object","additionalProperties":false,"required":["kind","name","city","matches","queryObservedAt"],"properties":{"kind":{"const":"venue"},"name":{"type":"string","minLength":1,"maxLength":240},"city":{"type":"string","minLength":1,"maxLength":120},"latitude":{"type":"number","minimum":-90,"maximum":90},"longitude":{"type":"number","minimum":-180,"maximum":180},"matches":{"type":"array","maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["name","city","status"],"properties":{"placeId":{"type":"string","minLength":1,"maxLength":160},"name":{"type":"string","minLength":1,"maxLength":240},"city":{"type":"string","minLength":1,"maxLength":120},"latitude":{"type":"number","minimum":-90,"maximum":90},"longitude":{"type":"number","minimum":-180,"maximum":180},"status":{"enum":["operational","temporarily_closed","permanently_closed","unknown"]}}}},"queryObservedAt":{"oneOf":[{"$ref":"#/$defs/instant"},{"type":"null"}]}}},{"type":"object","additionalProperties":false,"required":["kind","locationName","condition","observedAt"],"properties":{"kind":{"const":"weather_current"},"locationName":{"type":"string","minLength":1,"maxLength":240},"latitude":{"type":"number","minimum":-90,"maximum":90},"longitude":{"type":"number","minimum":-180,"maximum":180},"condition":{"type":"string","minLength":1,"maxLength":240},"conditionCode":{"type":"string","minLength":1,"maxLength":80},"observedAt":{"oneOf":[{"$ref":"#/$defs/instant"},{"type":"null"}]},"temperatureC":{"type":"number"},"feelsLikeC":{"type":"number"},"humidityPercent":{"type":"number","minimum":0,"maximum":100},"windDirection":{"type":"string","minLength":1,"maxLength":80},"windScale":{"type":"string","minLength":1,"maxLength":80},"precipitationMm":{"type":"number","minimum":0}}},{"type":"object","additionalProperties":false,"required":["kind","locationName","date","conditionDay","conditionNight"],"properties":{"kind":{"const":"weather_forecast"},"locationName":{"ty